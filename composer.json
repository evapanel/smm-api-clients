{
    "name": "evapanel/smm-api-client",
    "description": "A small PHP client for the standard SMM panel API (v2): services, orders, status, balance, refill and cancel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["smm", "smm panel", "smm api", "smm panel api", "reseller"],
    "homepage": "https://evapanel.com/blog/smm-panel-api-explained",
    "authors": [
        {
            "name": "Eva Panel",
            "email": "support@evapanel.com",
            "homepage": "https://evapanel.com"
        }
    ],
    "support": {
        "issues": "https://github.com/evapanel/smm-api-clients/issues",
        "source": "https://github.com/evapanel/smm-api-clients",
        "docs": "https://evapanel.com/blog/smm-panel-api-explained"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "EvaPanel\\SmmApi\\": "php/src/"
        }
    }
}
